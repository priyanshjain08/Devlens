# ---- Server ----
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://devlens:devlens@localhost:5432/devlens
# If your Postgres requires SSL (e.g. most hosted providers), set:
# PGSSL=true

# ---- AI Provider ----
# "anthropic" or "openai"
AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Max characters of source code accepted per analysis request
MAX_CODE_LENGTH=20000

# Requests allowed per IP per window (abuse protection for AI calls)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=30
